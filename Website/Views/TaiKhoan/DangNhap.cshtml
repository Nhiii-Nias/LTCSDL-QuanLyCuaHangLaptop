@model Website.Models.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
    string returnUrl = ViewBag.ReturnUrl as string ?? "";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:60vh">
    <div class="bb-form-card" style="width:100%;max-width:440px">
        <!-- Header -->
        <div class="text-center mb-4">
            <div style="font-size:52px;margin-bottom:8px">🔐</div>
            <h1 class="bb-form-title">Đăng Nhập</h1>
            <p class="bb-form-subtitle">Đăng nhập để mua hàng và theo dõi đơn hàng</p>
        </div>

        <form asp-action="DangNhap" asp-route-returnUrl="@returnUrl" method="post">
            @Html.AntiForgeryToken()

            <!-- Lỗi chung -->
            <div asp-validation-summary="ModelOnly" class="bb-alert bb-alert-danger" style="display:@(ViewContext.ModelState.Values.Any(v => v.Errors.Any()) ? "flex" : "none")"></div>

            <div class="bb-form-group">
                <label class="bb-label" asp-for="TenDangNhap">
                    <i class="fas fa-user me-1"></i> Tên đăng nhập
                </label>
                <input asp-for="TenDangNhap" class="bb-input" placeholder="Nhập tên đăng nhập" id="txtTenDangNhap" />
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>

            <div class="bb-form-group">
                <label class="bb-label" asp-for="MatKhau">
                    <i class="fas fa-lock me-1"></i> Mật khẩu
                </label>
                <div class="position-relative">
                    <input asp-for="MatKhau" class="bb-input" placeholder="Nhập mật khẩu" id="txtMatKhau"
                           style="padding-right:44px" />
                    <button type="button" class="bb-btn bb-btn-icon"
                            style="position:absolute;right:4px;top:50%;transform:translateY(-50%);
                                   background:none;border:none;color:#9E9E9E;padding:6px;"
                            onclick="togglePwd()" title="Hiện/ẩn mật khẩu">
                        <i class="fas fa-eye" id="pwdIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <label class="bb-filter-option" style="margin:0;font-size:13.5px">
                    <input asp-for="GhiNho" /> Ghi nhớ đăng nhập
                </label>
            </div>

            <button type="submit" class="bb-btn bb-btn-primary bb-btn-block bb-btn-lg" id="btnDangNhap">
                <i class="fas fa-sign-in-alt me-2"></i> Đăng Nhập
            </button>
        </form>

        <div class="bb-divider">hoặc</div>

        <div class="text-center">
            <p style="font-size:14px;color:#616161">
                Chưa có tài khoản?
                <a asp-controller="TaiKhoan" asp-action="DangKy"
                   style="color:#C62828;font-weight:700">Đăng ký ngay</a>
            </p>
            <a asp-controller="BaoHanh" asp-action="Index"
               style="font-size:13px;color:#757575">
                <i class="fas fa-shield-alt me-1"></i> Tra cứu bảo hành không cần đăng nhập
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd() {
            const inp = document.getElementById('txtMatKhau');
            const icon = document.getElementById('pwdIcon');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                inp.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>
}
