@model dynamic
@{
    ViewData["Title"] = "Xác nhận thanh toán đơn hàng";
    var donHang = ViewBag.DonHang as DTO_HTQLCuaHangLaptop.DTO_DonHang;
    bool isSuccess = ViewBag.IsSuccess ?? false;
    string message = ViewBag.Message ?? "";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 text-center">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-body p-5 bg-white">
                    @if (isSuccess)
                    {
                        <div class="mb-4">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bb-success-badge">
                                <i class="fas fa-check fa-2x"></i>
                            </span>
                        </div>
                        <h3 class="text-success font-weight-bold mb-3" style="font-family: 'Inter', sans-serif;">Ghi Nhận Thành Công!</h3>
                    }
                    else
                    {
                        <div class="mb-4">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bb-danger-badge">
                                <i class="fas fa-exclamation-triangle fa-2x"></i>
                            </span>
                        </div>
                        <h3 class="text-danger font-weight-bold mb-3" style="font-family: 'Inter', sans-serif;">Lỗi Xác Nhận</h3>
                    }

                    <p class="text-muted small px-2 mb-4">@message</p>

                    @if (donHang != null)
                    {
                        <div class="border rounded-3 p-3 bg-light text-start mb-4" style="font-size: 14px;">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Mã đơn hàng:</span>
                                <span class="font-weight-bold text-dark">@donHang.MaDH</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Phương thức thanh toán:</span>
                                <span class="text-dark">@donHang.PhuongThucThanhToan</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Trạng thái hiện tại:</span>
                                <span class="badge bg-success text-white px-2 py-1" style="font-size: 11px;">Đang Giao</span>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Tổng số tiền:</span>
                                <span class="font-weight-bolder text-danger fs-5">@((donHang.TienSauGiam ?? donHang.TongTien).ToString("N0")) ₫</span>
                            </div>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <a href="/" class="btn btn-primary rounded-pill py-2 shadow-sm font-weight-bold" style="background-color: #c62828; border-color: #c62828; transition: all 0.2s;">
                            <i class="fas fa-home me-2"></i> Quay Về Trang Chủ
                        </a>
                        <a asp-controller="DonHang" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2" style="transition: all 0.2s;">
                            <i class="fas fa-box me-2"></i> Đơn Hàng Của Tôi
                        </a>
                    </div>
                </div>
            </div>
            
            <p class="text-muted small mt-4">
                © 2026 Cửa Hàng Laptop BulaBula. Đề tài Lập Trình CSDL.
            </p>
        </div>
    </div>
</div>

@section Styles {
<style>
    .bb-success-badge {
        width: 70px;
        height: 70px;
        background-color: #e8f5e9;
        color: #2e7d32;
        box-shadow: 0 4px 10px rgba(46,125,50,0.15);
    }
    
    .bb-danger-badge {
        width: 70px;
        height: 70px;
        background-color: #ffebee;
        color: #c62828;
        box-shadow: 0 4px 10px rgba(198,40,40,0.15);
    }

    .btn-primary:hover {
        background-color: #b71c1c !important;
        border-color: #b71c1c !important;
    }
</style>
}
